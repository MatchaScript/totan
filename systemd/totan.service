[Unit]
Description=totan transparent proxy
Documentation=https://github.com/matchascript/totan
# The eBPF programs and the policy routing rules must be in place before the
# services whose egress totan intercepts start talking to the network.
# network-pre.target is passive: it is pulled in and ordered by the units that
# need to run before network configuration, so order this unit Before= it, not
# After= it (systemd.special(7)). Default dependencies stay on: totan is an
# ordinary system daemon and needs basic.target (cgroup hierarchy, bpffs,
# /etc/totan) before it starts.
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=exec
ExecStart=/usr/local/bin/totan --config /etc/totan/config.toml
Restart=on-failure
RestartSec=2
# totan runs as root inside system.slice: cgroup/connect4 skips its own
# sockets by SO_MARK, so hooking the slice it lives in does not loop.
Slice=system.slice
# CAP_BPF          load the tc, cgroup/connect and sockops programs and maps
# CAP_PERFMON      the aya-log perf event array opened by EbpfLogger::init
# CAP_NET_ADMIN    tcx and cgroup attach, IP_TRANSPARENT and IP_FREEBIND on the
#                  TPROXY listeners, SO_MARK on upstream sockets, and the
#                  `ip rule` / `ip route` calls for table 100
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
